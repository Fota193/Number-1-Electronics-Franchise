package com.mycompany.electronicsfranchise;

/**
 *
 * @author Student
 */
import java.util.*;
public class ElectronicsFranchise {

    public static void main(String[] args) {
        // Single arrays
        String[] cities = {"CAPE TOWN","PORT ELIZABETH", "PRETORIA"};
        String[] consoles = {"PS5", "XBOX","SWITCH"};
        // Two-dimensional array: rows = cities, columns = consoles
        int[][] sales = {
            {1000, 2000, 3000},   // Cape Town
            {2000, 3000, 4000},   // Port Elizabeth
            {1500, 1100, 1200}    // Pretoria
        };
        int[] totals = new 
        int[cities.length];
        // Report header
        System.out.println("GAMING CONSOLE REPORT");
        System.out.println("----------------------------------------------------");
        System.out.printf("%-18s", "");
        for (String console : consoles) {
            System.out.printf("%-10s", console);
        }
        System.out.println();
        // Sales per city + totals
        for (int i = 0; i < cities.length; i++) {
            System.out.printf("%-18s",  cities[i]);
            for (int j = 0; j < consoles.length; j++) {
                System.out.printf("%-10d", sales[i][j]);
                totals[i] += sales[i][j];
            }
            System.out.println();
        }
        // Totals for each city
        System.out.println("\nGAMING CONSOLE SALES TOTALS FOR EACH CITY");
        System.out.println("----------------------------------------------------");
        for (int i = 0; i < cities.length; i++) {
            System.out.printf("%-18s%d%n", cities[i], totals[i]);
        }
        // City with the most sales
        int maxIndex = 0;
        for (int i = 1; i < totals.length;i++) {
            if (totals[i] > totals[maxIndex]) {
                maxIndex = i;
            }
        }
        System.out.println("----------------------------------------------------");
        System.out.println("CITY WITH THE MOST SALES: " + cities[maxIndex]);
    }
}